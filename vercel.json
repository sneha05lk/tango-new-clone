{
  "version": 2,
  "functions": {
    "server/index.js": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "client/uploads/$1"
    },
    {
      "src": "/(.*)\\.(js|css|png|jpg|jpeg|gif|svg|ico)",
      "dest": "client/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "client/index.html"
    }
  ]
}
