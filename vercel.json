{
  "version": 2,
  "functions": {
    "server/index.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/client/uploads/$1"
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|svg|ico)",
      "destination": "/client/$1.$2"
    },
    {
      "source": "/(.*)",
      "destination": "/client/index.html"
    }
  ]
}
